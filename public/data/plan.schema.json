{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sport-hermes/plan@1",
  "title": "Plan d'entraînement SPORT-HERMES",
  "description": "Écrit par le coach IA. plan → blocs → semaines → séances + tests. Dates au format YYYY-MM-DD (jour local).",
  "type": "object",
  "required": ["schema", "id", "title", "goal", "start", "end", "targets", "benchmarks", "blocks"],
  "$defs": {
    "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "unit": { "enum": ["kg", "reps", "s"] },
    "session": {
      "type": "object",
      "required": ["id", "title", "type", "detail", "done", "doneOn"],
      "properties": {
        "id": { "type": "string", "description": "unique dans tout le plan, stable (sert de clé aux cases cochées)" },
        "title": { "type": "string" },
        "type": { "enum": ["force", "hypertrophie", "zone2", "intervalles", "hyrox", "mobilite", "autre"] },
        "detail": { "type": "string", "description": "une ligne : exercices, charges, consignes" },
        "done": { "type": "boolean" },
        "doneOn": { "anyOf": [{ "$ref": "#/$defs/day" }, { "type": "null" }] },
        "note": { "type": ["string", "null"] }
      }
    },
    "test": {
      "type": "object",
      "required": ["id", "date", "benchmarkId", "exercise", "result", "unit"],
      "properties": {
        "id": { "type": "string" },
        "date": { "$ref": "#/$defs/day" },
        "benchmarkId": { "type": "string" },
        "exercise": { "type": "string" },
        "result": { "type": ["number", "null"], "description": "kg, reps, ou secondes pour un chrono ; null tant que non fait" },
        "unit": { "$ref": "#/$defs/unit" }
      }
    },
    "week": {
      "type": "object",
      "required": ["id", "index", "start", "end", "sessions", "tests"],
      "properties": {
        "id": { "type": "string" },
        "index": { "type": "integer", "minimum": 1 },
        "start": { "$ref": "#/$defs/day" },
        "end": { "$ref": "#/$defs/day" },
        "sessions": { "type": "array", "items": { "$ref": "#/$defs/session" } },
        "tests": { "type": "array", "items": { "$ref": "#/$defs/test" } }
      }
    }
  },
  "properties": {
    "schema": { "const": "sport-hermes/plan@1" },
    "demo": { "type": "boolean" },
    "id": { "type": "string" },
    "title": { "type": "string" },
    "goal": { "type": "string" },
    "start": { "$ref": "#/$defs/day" },
    "end": { "$ref": "#/$defs/day" },
    "event": {
      "type": ["object", "null"],
      "required": ["name", "date"],
      "properties": { "name": { "type": "string" }, "date": { "$ref": "#/$defs/day" }, "description": { "type": "string" } }
    },
    "targets": {
      "type": "object",
      "required": ["sessionsPerWeek", "sleepMinutes", "bedtime"],
      "properties": {
        "sessionsPerWeek": { "type": "integer", "minimum": 1 },
        "sleepMinutes": { "type": "integer", "minimum": 300 },
        "bedtime": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
        "weight": {
          "type": ["object", "null"],
          "properties": {
            "startKg": { "type": ["number", "null"] },
            "gainPerWeekKg": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
          }
        }
      }
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "unit", "better", "baseline"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "unit": { "$ref": "#/$defs/unit" },
          "better": { "enum": ["higher", "lower"] },
          "baseline": {
            "type": ["object", "null"],
            "required": ["value", "estimated"],
            "properties": { "value": { "type": "number" }, "estimated": { "type": "boolean" }, "display": { "type": "string" } }
          },
          "target": { "type": ["number", "null"] }
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "goal", "start", "end", "weeks"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "goal": { "type": "string" },
          "start": { "$ref": "#/$defs/day" },
          "end": { "$ref": "#/$defs/day" },
          "weeks": { "type": "array", "items": { "$ref": "#/$defs/week" } }
        }
      }
    }
  }
}
